{
  "name": "agent-stack",
  "version": "0.1.0",
  "description": "My personal agent stack for one-command setup, reusable skills, and custom agents.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "agent-stack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/cli.js",
    "validate": "node dist/cli.js validate --repo .",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run build && node --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "verify:binary": "node scripts/verify-binary.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "commander": "15.1.0",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "picocolors": "1.1.1",
    "semver": "7.7.3",
    "smol-toml": "1.9.1",
    "tar": "7.5.23",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "@types/semver": "7.7.1",
    "esbuild": "0.25.12",
    "typescript": "7.0.2"
  }
}
