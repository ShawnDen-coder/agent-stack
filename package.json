{
  "name": "agent-stack",
  "version": "0.1.0",
  "private": true,
  "description": "My personal agent stack for one-command setup, reusable skills, and custom agents.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "agent-stack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/cli.js",
    "validate": "node dist/cli.js validate --repo .",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run build && node --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "15.1.0",
    "semver": "7.7.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "@types/semver": "7.7.1",
    "typescript": "7.0.2"
  }
}
